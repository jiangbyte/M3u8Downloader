{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "M3U8 Downloader",
  "version": "0.1.0",
  "identifier": "com.jiangbyte.m3u8downloader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node scripts/prepare-ffmpeg.mjs && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "M3U8 Downloader",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg"],
    "externalBin": ["binaries/ffmpeg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
